generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  SYSTEM
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  resetCodeHash        String?
  resetCodeExpiresAt   DateTime?
  lastSeenAt           DateTime?
  role                 String               @default("USER")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  profile              Profile?
  podcasts             Podcast[]            @relation("PodcastAuthor")
  reels                Reel[]               @relation("ReelAuthor")
  communities          Community[]          @relation("CommunityOwner")
  posts                Post[]
  comments             Comment[]
  likes                Like[]
  notifications        Notification[]       @relation("NotificationRecipient")
  sentNotifications    Notification[]       @relation("NotificationActor")
  communityMemberships CommunityMember[]
  conversationMembers  ConversationMember[]
  sentMessages         Message[]
  followers            Follow[]             @relation("UserFollowers")
  following            Follow[]             @relation("UserFollowing")

  @@index([createdAt])
  @@index([lastSeenAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?  @db.VarChar(500)
  avatarUrl   String?
  phone       String?  @db.VarChar(30)
  company     String?  @db.VarChar(120)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Podcast {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  coverUrl    String?
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation("PodcastAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  episodes    Episode[]

  @@index([authorId])
  @@index([publishedAt])
}

model Episode {
  id          String    @id @default(cuid())
  podcastId   String
  title       String
  description String?   @db.Text
  audioUrl    String
  durationSec Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  podcast     Podcast   @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId, publishedAt])
}

model Reel {
  id        String   @id @default(cuid())
  authorId  String
  caption   String?  @db.VarChar(1000)
  videoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("ReelAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
}

model Community {
  id          String            @id @default(cuid())
  ownerId     String
  name        String            @unique
  description String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  posts       Post[]
  members     CommunityMember[]

  @@index([ownerId])
}

model CommunityMember {
  id          String    @id @default(cuid())
  userId      String
  communityId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, createdAt])
}

model Post {
  id            String         @id @default(cuid())
  authorId      String
  communityId   String?
  content       String         @db.Text
  imageUrl      String?
  videoUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community     Community?     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         Like[]
  notifications Notification[]

  @@index([communityId, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  authorId  String
  postId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  postId      String?
  type        NotificationType
  message     String
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([actorId])
  @@index([postId])
}

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}
