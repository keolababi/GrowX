{
  "expo": {
    "name": "GrowX",
    "slug": "growx",
    "version": "1.0.0",
    "scheme": "growx",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "GrowX-д зураг болон бичлэг нийтлэхийн тулд сан руу хандана."
        }
      ],
      "expo-document-picker",
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
